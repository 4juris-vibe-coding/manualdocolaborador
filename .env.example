# 4JURIS Pessoas — variáveis de ambiente (copie para .env.local)
# Nunca versione segredos reais.

# Fonte de dados: 'demo' (dados fictícios no navegador) ou 'api' (banco Supabase via /api, com login por senha).
VITE_DATA_SOURCE=api

# URL base da API; deixe vazio para usar o mesmo domínio (/api).
VITE_API_URL=

# Textos institucionais
VITE_NOME_EMPRESA=4JURIS
VITE_EMAIL_RH=rh@4juris.com.br

# --- SOMENTE no servidor (NUNCA com prefixo VITE_) — configure também na Vercel ---
# Connection string do Supabase (pooler). Senha com caracteres especiais deve ser percent-encoded (@ vira %40).
DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Segredo de assinatura da sessão (>= 32 caracteres aleatórios): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Caixa de sugestões anônima: segredo que deriva a chave de cada pessoa (>= 32 caracteres, fora do banco).
# Sem ele, usa o SESSION_SECRET. Trocar depois invalida a autoria das sugestões existentes (só a edição pela autora).
ANON_SECRET=

# Alertas diários do financeiro (Vercel Cron chama /api/v2/financeiro/cron/alertas com Authorization: Bearer <CRON_SECRET>).
# Sem a variável, o agendamento fica recusado e os alertas rodam quando alguém abre o painel financeiro (no máximo a cada 12 h).
CRON_SECRET=

# Redefinição de senha por e-mail (Resend). Sem a chave, o link só aparece no log do servidor.
RESEND_API_KEY=
RESEND_FROM=4JURIS <nao-responda@somos4juris.com.br>
PORTAL_URL=https://portaldocolaborador.somos4juris.com.br
