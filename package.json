  "version": "0.1.0",
  "type": "module",
  "description": "4JURIS Pessoas — plataforma de gestão de pessoas e colaboradores PJ",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gerar-schema-v2.mjs && vite build",
