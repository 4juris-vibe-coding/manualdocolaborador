{
  "rewrites": [
    {
      "source": "/api/v2/:caminho(.*)",
      "destination": "/api/v2?__caminho=:caminho"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/v2/financeiro/cron/alertas",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/v2/rh/cron/diario",
      "schedule": "15 9 * * *"
    }
  ]
}
